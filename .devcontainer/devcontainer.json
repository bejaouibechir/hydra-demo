{
  "name": "Hydra ETL demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [5678, 3307],
  "portsAttributes": {
    "5678": { "label": "Hydra Studio", "onAutoForward": "openPreview" },
    "3307": { "label": "MySQL (demo)", "onAutoForward": "silent" }
  },

  "remoteEnv": {
    "MYSQL_USER": "hydra",
    "MYSQL_PASSWORD": "hydra-demo-password",
    "HYDRA_WORKSPACE": "${containerWorkspaceFolder}/.."
  },

  "customizations": {
    "vscode": {
      "extensions": ["redhat.vscode-yaml"]
    }
  }
}
